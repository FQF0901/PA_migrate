			{			
				select ".bss.Rte_OsApplication_C2.*";
				select ".bss.core2.*";
				#include "select_core2_bss_int.lsl"												
			}
			"__STARTBSS_ANON_C2" = "_lc_ub_bss.Grp_DSPR2_Int";
			"__ENDBSS_ANON_C2"   = "_lc_ue_bss.Grp_DSPR2_Int";
		}
		/* Core2 -- External .data and .bss  int_ram_core0*/
