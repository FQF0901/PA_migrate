	    {
			/* Uninitialized Data */
			select ".bss.Notifications.*";	//Shall added the section to this group,otherwise,the MCU enter trap.
			select ".bss.McalLib*";			//Shall added the section to this group,otherwise,the MCU enter trap.
			select ".bss.Icu_17_TimerIp*";	//Shall added the section to this group,otherwise,the MCU enter trap.	
	    }
	    group Grp_DSPR0_BLFlag (align=4, ordered, nocopy,  run_addr = 0x70027F00)
	    {
			select ".bss.Diagnostic_UserFunctions.BLFlag";	
	    }

		/* Core1 -- Internal .data and .bss */
		group Grp_DSPR1_Int (align=4, nocopy,run_addr = mem:int_ram_core1)
	    {
			section "data.Grp_DSPR1_Int" (attributes=rw, blocksize=4)
			{				
				#include "select_core1_data_int.lsl"	
			}
			"__STARTDATA_ANON_C1" = "_lc_ub_data.Grp_DSPR1_Int";
			"__ENDDATA_ANON_C1"   = "_lc_ue_data.Grp_DSPR1_Int";

			section "bss.Grp_DSPR1_Int" (attributes=rw, blocksize=4)
			{				
				select ".bss.Rte_OsApplication_C1.*";
				select ".bss.core1.*";	
				#include "select_core1_bss_int.lsl"						
			}
			"__STARTBSS_ANON_C1" = "_lc_ub_bss.Grp_DSPR1_Int";
			"__ENDBSS_ANON_C1"   = "_lc_ue_bss.Grp_DSPR1_Int";
		}

		/* Core2 -- Internal .data and .bss */
		group Grp_DSPR2_Int (align=4, nocopy,run_addr = mem:int_ram_core2)
	    {
			section "data.Grp_DSPR2_Int" (attributes=rw, blocksize=4)
			{				
				#include "select_core2_data_int.lsl"
			}
