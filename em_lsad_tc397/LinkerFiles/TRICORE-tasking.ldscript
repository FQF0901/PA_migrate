//
// Common part of linker script for the Tasking linker
// This file will be included into the generated linker script.
//
// The internal DSPR RAM is divided between data & CSAs for each core.
// The end of the DSPR is used for a configured number of CSAs, the rest
// is left for data. The number of CSAs available to each core is configured
// in Tresos Studio (within OsCoreConfig)
#define TSK_DATA_FILL_CHARACTER				0xFF

// define the Block A macro
#define TSK_COMPILE_CODE_IN_BLOCK_A			0x01
// define the Block B macro
#define TSK_COMPILE_CODE_IN_BLOCK_B			0x02
// define optimize CPU version
#define TSK_COMPILE_CODE_VERSION_NEW		0x03
// define not optimize CPU version
#define TSK_COMPILE_CODE_VERSION_OLD		0x04

// The integrator using this macro to select the code compiling to which block
#define TSK_COMPILE_CODE_IN_BLOCK					TSK_COMPILE_CODE_IN_BLOCK_A
//Define PFLASH address where to start from, NEW is optimize CPU, OLD is not optimize CPU.
#define TSK_COMPILE_CODE_PFLASH_START_ADDRESS		TSK_COMPILE_CODE_VERSION_NEW

// Physical memory size,only use for MCU Application
#if(TSK_COMPILE_CODE_PFLASH_START_ADDRESS == TSK_COMPILE_CODE_VERSION_NEW)
// Program Flash_NEW,the address range is 0xA0106000~0xA06FFFFF //or 0xA0506000~0xA0AFFEFF,include the const value section before code section;
#define PFLASH_SIZE_CPU0 					0x5FA000
#elif(TSK_COMPILE_CODE_PFLASH_START_ADDRESS == TSK_COMPILE_CODE_VERSION_OLD)
// Program Flash,the address range is 0x80104000~0x804FFEFF or 0x80504000~0x808FFEFF,include the const value section before code section;
#define PFLASH_SIZE_CPU0 					0x3FBF00
#endif

