/* internal DSPRs of the different cores */
memory int_ram_core0
{
	mau = 8;
	size = DSPR0_VAR_DEFAULT_SECTION_SIZE;
	type = ram;
	map (dest=bus:tc0:fpi_bus, dest_offset=0xd0000000, size=DSPR0_VAR_DEFAULT_SECTION_SIZE, priority=8);	
	map (dest=bus:sri, dest_offset=DSPR0_START_ADDRESS, size=DSPR0_VAR_DEFAULT_SECTION_SIZE);
}  

